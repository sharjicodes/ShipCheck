generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ScanStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model Scan {
  id          String     @id @default(cuid())
  url         String     @db.VarChar(2048)
  hostname    String     @db.VarChar(253)
  status      ScanStatus @default(QUEUED)
  error       String?    @db.VarChar(1000)
  summary     Json?
  findings    Json?
  createdAt   DateTime   @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  durationMs  Int?
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([hostname, createdAt])
}
