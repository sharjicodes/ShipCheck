{
  "name": "@shipcheck/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "set -a && . ../../.env && set +a && tsx watch src/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
